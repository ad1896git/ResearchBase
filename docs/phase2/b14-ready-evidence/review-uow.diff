@@ -343,0 +344,27 @@ def _approval_database_error(exc: DBAPIError) -> ResearchBaseError:
+    if strict:
+        ready_codes = {
+            "P17F1": ErrorCode.IMMUTABLE_RECORD,
+            "P17F2": ErrorCode.PROVENANCE_CLOSURE_VIOLATION,
