diff --git a/src/researchbase/persistence/approval_repository.py b/src/researchbase/persistence/approval_repository.py
index 79e8729..b7223da 100644
--- a/src/researchbase/persistence/approval_repository.py
+++ b/src/researchbase/persistence/approval_repository.py
@@ -458,0 +459,16 @@ class SqlAlchemyApprovalRepository(SqlAlchemyRevisionActionRepository):
+    def issuer_bindings(self, actor, at):
+        return [
+            dict(r)
+            for r in self._session.execute(
+                text(
+                    "SELECT * FROM actor_subject_bindings "
+                    "WHERE actor_id=:actor AND status='ACTIVE' "
+                    "AND bound_at<=:at AND (revoked_at IS NULL OR :at<revoked_at) ORDER BY id"
+                ),
+                {"actor": actor, "at": at},
+            ).mappings()
+        ]
+
+    def consumption_by_id(self, identity):
+        return self._one("SELECT * FROM approval_grant_consumptions WHERE id=:id", {"id": identity})
+
